{
  "name": "panel",
  "templateProps": {
    "title": "Create an Account",
    "variant": "elevated",
    "elevation": "floating",
    "children": [
      {
        "name": "stack",
        "templateProps": {
          "spacing": "large",
          "children": [
            {
              "name": "text-field",
              "templateProps": { "label": "Full Name", "placeholder": "Jane Doe", "required": true }
            },
            {
              "name": "text-field",
              "templateProps": { "label": "Email Address", "type": "email", "placeholder": "jane@example.com", "required": true }
            },
            {
              "name": "text-field",
              "templateProps": { "label": "Password", "type": "password", "required": true }
            },
            {
              "name": "checkbox",
              "templateProps": { "label": "I agree to the Terms and Conditions", "defaultChecked": false }
            },
            {
              "name": "flexbox",
              "templateProps": {
                "justify": "space-between",
                "align": "center",
                "children": [
                  { "name": "button", "templateProps": { "label": "Cancel", "variant": "ghost" } },
                  { "name": "button", "templateProps": { "label": "Sign Up", "variant": "primary" } }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
