                      "cornerRadius": 4,
                      "legend": true,
                      "centerLabel": "71%",
                      "data": [
                        { "id": "steps",    "value": 84, "label": "Steps",    "color": "#F97316" },
                        { "id": "calories", "value": 89, "label": "Calories", "color": "#10B981" },
                        { "id": "sleep",    "value": 97, "label": "Sleep",    "color": "#6366F1" },
