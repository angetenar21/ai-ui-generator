# Backend API Configuration
# URL for the Express backend server (used by frontend)
VITE_API_BASE_URL=http://localhost:4000

# Backend Configuration (for backend/server.js)
# Port for the Express backend server
BACKEND_PORT=4000

# Google Gemini API Key(s)
# Get your API key from: https://makersuite.google.com/app/apikey
# You can specify ONE key:
GEMINI_API_KEY=your_gemini_api_key_here

# OR multiple keys (comma-separated) for automatic fallback if one quota is exhausted:
# GEMINI_API_KEYS=key1_here,key2_here,key3_here

# Gemini Model Configuration
GEMINI_MODEL=gemini-2.5-pro
