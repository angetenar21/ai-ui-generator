# Backend API Configuration
# URL for the Express backend server (used by frontend)
VITE_API_BASE_URL=http://localhost:4000

# Backend Configuration (for backend/server.js)
# Port for the Express backend server
BACKEND_PORT=4000

# Google Gemini API Keys
# You can provide a single key:
# GEMINI_API_KEY=your_api_key_here
#
# OR, to prevent hitting "Resource Exhausted" 429 errors from Google,
# provide multiple keys separated by commas. The backend will automatically
# rotate to the next key if one runs out of credits/quota!
GEMINI_API_KEYS=key1,key2,key3

# Gemini Model Selection (gemini-2.5-pro has stricter limits, gemini-1.5-flash is faster and has higher limits)

# Firebase Frontend Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Admin Configuration (Backend)
# Paste the raw JSON string from your downloaded Firebase Service Account key here:
FIREBASE_SERVICE_ACCOUNT_JSON={
  "type": "service_account",
  "project_id": "your_project_id",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"
}
