# Backend API Configuration
# URL for the Express backend server (used by frontend)
VITE_API_BASE_URL=http://localhost:4000

# Backend Configuration (for backend/server.js)
# Port for the Express backend server
BACKEND_PORT=4000

# Google Gemini API Keys
# You can provide a single key:
# GEMINI_API_KEY=your_api_key_here
#
# OR, to prevent hitting "Resource Exhausted" 429 errors from Google,
# provide multiple keys separated by commas. The backend will automatically
# rotate to the next key if one runs out of credits/quota!
GEMINI_API_KEYS=key1,key2,key3

# Gemini Model Selection (gemini-2.5-pro has stricter limits, gemini-1.5-flash is faster and has higher limits)
